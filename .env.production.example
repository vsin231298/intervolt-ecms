# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# Database password (any long random string)
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password

# Public address people will use, e.g. https://ecms.intervolt.ca or http://<server-ip>:3000
APP_URL=http://localhost:3000
APP_PORT=3000

# Secret for the reminder endpoint (any long random string, 32+ characters)
JOBS_SECRET=CHANGE_ME_another_long_random_secret

# First administrator (used once by: docker compose run --rm app npm run db:setup)
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=CHANGE_ME_Strong1234

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2

# HTTPS address for the built-in Caddy proxy, e.g. intervolt-ecms.duckdns.org (free at duckdns.org)
DOMAIN=

# Optional: Cloudflare Tunnel token (free) for HTTPS without opening router ports
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: S3-compatible storage instead of local disk (e.g. Cloudflare R2 free tier). Leave blank for local disk.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Where nightly backups are written (e.g. a OneDrive folder on Windows)
# BACKUP_DIR=C:/Users/you/OneDrive/Intervolt-Backups
